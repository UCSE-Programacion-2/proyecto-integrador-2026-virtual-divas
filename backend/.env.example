# Copiá este archivo como .env y completá los valores (NO subir el .env)
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pintunort

# Clave para firmar los tokens de sesión (cualquier texto largo y secreto)
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# Usuario administrador que crea "npm run seed"
ADMIN_NAME=Admin PintuNort
ADMIN_EMAIL=admin@pintunort.com
ADMIN_PASSWORD=admin123

# Orígenes permitidos por CORS, separados por coma.
# En producción poné la URL de Vercel (y la de GitHub Pages si usan el vanilla)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5500
